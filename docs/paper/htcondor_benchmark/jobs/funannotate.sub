# HTCondor submit file for funannotate benchmark runs.
# 18 jobs: 6 genomes x 3 replicates.

universe       = vanilla
executable     = $(BENCHMARK_DIR)/jobs/run_funannotate.sh
getenv         = true

request_cpus   = 8
request_memory = 16 GB
request_disk   = 30 GB

# funannotate's augustus (env funannotate, 3.5.0) is AVX2-compiled, like the
# BRAKER arm's. On a non-AVX2 node (x86_64-v2, e.g. scarcity-10) its config-time
# "augustus --proteinprofile" BUSCO self-test fails ("likely a compilation
# error") and funannotate aborts before prediction. The first full run's
# funannotate completion was partly luck-of-the-node; gate to AVX2-capable nodes
# so every job's augustus runs. (MycoNote's augustus 3.3.3 is NOT AVX2-compiled
# and needs no such gate.)
requirements   = (TARGET.has_avx2 =?= true)

log    = $(RESULTS_DIR)/funannotate/$(genome_id)_rep$(rep).log
output = $(RESULTS_DIR)/funannotate/$(genome_id)_rep$(rep).out
error  = $(RESULTS_DIR)/funannotate/$(genome_id)_rep$(rep).err

arguments = $(genome_id) $(rep) $(BENCHMARK_DIR) $(DATA_DIR) $(RESULTS_DIR)

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT

notification = Never

queue genome_id, rep from (
    sce 1
    sce 2
    sce 3
    cal 1
    cal 2
    cal 3
    ylp 1
    ylp 2
    ylp 3
    ani 1
    ani 2
    ani 3
    ncr 1
    ncr 2
    ncr 3
    cne 1
    cne 2
    cne 3
)
