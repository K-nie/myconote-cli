Bootstrap: docker
From: condaforge/mambaforge:latest

%labels
    Author Benjamin Narh-Madey <narhmadey@wisc.edu>
    Description myconote-cli: High-performance eukaryotic genome annotation pipeline
    Version 0.2.0
    URL https://github.com/K-nie/myconote-cli

%files
    # Copy the pre-built binary into the container
    # Build it first: cargo build --release --target x86_64-unknown-linux-gnu
    target/x86_64-unknown-linux-gnu/release/myconote-cli /usr/local/bin/myconote-cli

%post
    chmod +x /usr/local/bin/myconote-cli

    # Install bioinformatics tools via mamba
    mamba install -y -c bioconda -c conda-forge \
        augustus \
        snap \
        glimmerhmm \
        repeatmasker \
        repeatmodeler \
        minimap2 \
        samtools \
        trinity \
        pasa \
        transdecoder \
        mmseqs2 \
        diamond \
        hmmer \
        eggnog-mapper \
        busco \
        trnascan-se \
        blast \
        mafft \
        muscle \
        iqtree \
        fasttree \
        miniprot

    # Install pip tools
    pip install --no-cache-dir pybiolib

    # Clean up
    mamba clean -afy

    # Create default database directory
    mkdir -p /root/.myconote/dbs

%environment
    export PATH="/opt/conda/bin:/usr/local/bin:$PATH"
    export LC_ALL=C

%runscript
    exec myconote-cli "$@"

%test
    myconote-cli --version

%help
    myconote-cli: High-performance eukaryotic genome annotation pipeline for eukaryotic genomes.
    Hittinger Lab, Laboratory of Genetics, UW-Madison.

    Usage:
        singularity run myconote-cli.sif <command> [options]
        apptainer run myconote-cli.sif <command> [options]

    Examples:
        # Predict genes
        singularity run myconote-cli.sif predict genome.fa --kingdom fungi

        # Annotate
        singularity run myconote-cli.sif annotate genes.gff3 --fasta genome.fa

        # Check installed tools
        singularity exec myconote-cli.sif myconote-cli check

        # Interactive tutorial
        singularity run myconote-cli.sif learn

    Building this container:
        # 1. Cross-compile for Linux first
        cargo build --release --target x86_64-unknown-linux-gnu

        # 2. Build the container
        sudo singularity build myconote-cli.sif Singularity.def
        # or with Apptainer:
        apptainer build myconote-cli.sif Singularity.def
