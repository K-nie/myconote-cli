# HTCondor submit file for MycoNote-CLI benchmark runs
# Submits 18 jobs: 6 genomes x 3 replicates
#
# Usage:
#   condor_submit myconote.sub
#
# Required environment (getenv=true propagates the submitting shell's env,
# so `source configs/htcondor.conf` before condor_submit):
#   BENCHMARK_DIR        - root directory of the benchmark
#   DATA_DIR             - directory containing genome data (one subdir per genome)
#   RESULTS_DIR          - directory for outputs
#   MYCONOTE_DB_DIR      - annotate database directory (default ~/.myconote/dbs)
#   AUGUSTUS_CONFIG_PATH - Augustus species configs (default ~/.myconote/augustus_config)

universe       = vanilla
executable     = $(BENCHMARK_DIR)/jobs/run_myconote.sh
getenv         = true

# Resources per job
request_cpus   = 8
request_memory = 16 GB
request_disk   = 10 GB

# Logging
log    = $(RESULTS_DIR)/myconote/$(genome_id)_rep$(rep).log
output = $(RESULTS_DIR)/myconote/$(genome_id)_rep$(rep).out
error  = $(RESULTS_DIR)/myconote/$(genome_id)_rep$(rep).err

# Arguments: genome_id, replicate_number
arguments = $(genome_id) $(rep) $(BENCHMARK_DIR) $(DATA_DIR) $(RESULTS_DIR)

# Transfer required files
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT

# Notification
notification = Never

# Fair-timing: pin ALL tools to the SAME AVX2-capable node class. AVX2 nodes are
# a superset (they also run MycoNote/MAKER's non-AVX2 binaries), and it is the
# only class where funannotate/BRAKER's AVX2-compiled Augustus 3.5.0 can run, so
# it is the common hardware for a fair wall-time comparison. Portability
# (MycoNote/MAKER also run the non-AVX2 pool) is measured on a separate axis.
requirements = (TARGET.has_avx2 =?= true)
# For the headline timing production run, additionally pin each genome's full
# tool x rep block to ONE machine for a true repeated-measures comparison, e.g.:
#   requirements = (TARGET.has_avx2 =?= true) && (Machine == "scarcityNN.glbrc.org")

# Submit one job per (genome, replicate) combination.
# 6 genomes x 3 replicates = 18 jobs total.
queue genome_id, rep from (
    sce 1
    sce 2
    sce 3
    cal 1
    cal 2
    cal 3
    ylp 1
    ylp 2
    ylp 3
    ani 1
    ani 2
    ani 3
    ncr 1
    ncr 2
    ncr 3
    cne 1
    cne 2
    cne 3
)
