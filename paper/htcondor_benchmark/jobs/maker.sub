# HTCondor submit file for MAKER benchmark runs.
# 18 jobs: 6 genomes x 3 replicates.

universe       = vanilla
executable     = $(BENCHMARK_DIR)/jobs/run_maker.sh
getenv         = true

request_cpus   = 8
request_memory = 32 GB
request_disk   = 30 GB
+RequestRuntime = 43200   # 12 hours per job

log    = $(RESULTS_DIR)/maker/$(genome_id)_rep$(rep).log
output = $(RESULTS_DIR)/maker/$(genome_id)_rep$(rep).out
error  = $(RESULTS_DIR)/maker/$(genome_id)_rep$(rep).err

arguments = $(genome_id) $(rep) $(BENCHMARK_DIR) $(DATA_DIR) $(RESULTS_DIR)

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT

notification = Error
notify_user  = narhmadey@wisc.edu

queue genome_id, rep from (
    sce 1
    sce 2
    sce 3
    cal 1
    cal 2
    cal 3
    ylp 1
    ylp 2
    ylp 3
    ani 1
    ani 2
    ani 3
    ncr 1
    ncr 2
    ncr 3
    cne 1
    cne 2
    cne 3
)
