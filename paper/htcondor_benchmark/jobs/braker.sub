# HTCondor submit file for BRAKER benchmark runs.
# 18 jobs: 6 genomes x 3 replicates.

universe       = vanilla
executable     = $(BENCHMARK_DIR)/jobs/run_braker.sh
getenv         = true

request_cpus   = 16
request_memory = 64 GB
request_disk   = 30 GB

# augustus 3.5.0 in the braker env (myconote_braker3) is compiled with AVX2
# (1912 ymm instruction refs). On execute nodes that lack AVX2 (x86_64-v2,
# e.g. scarcity-10) augustus aborts with SIGILL -- "Illegal instruction
# (core dumped)" -- at braker.pl:2551 config self-test, so the job exits 1
# with no braker.gtf. Cluster 145888 had 15/18 jobs packed onto scarcity-10
# and all failed there; jobs on AVX2 nodes (scarcity-20/-3) ran fine. Gate
# BRAKER to AVX2-capable nodes so augustus runs everywhere it is scheduled.
requirements   = (TARGET.has_avx2 =?= true)

log    = $(RESULTS_DIR)/braker/$(genome_id)_rep$(rep).log
output = $(RESULTS_DIR)/braker/$(genome_id)_rep$(rep).out
error  = $(RESULTS_DIR)/braker/$(genome_id)_rep$(rep).err

arguments = $(genome_id) $(rep) $(BENCHMARK_DIR) $(DATA_DIR) $(RESULTS_DIR)

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT

notification = Never

queue genome_id, rep from (
    sce 1
    sce 2
    sce 3
    cal 1
    cal 2
    cal 3
    ylp 1
    ylp 2
    ylp 3
    ani 1
    ani 2
    ani 3
    ncr 1
    ncr 2
    ncr 3
    cne 1
    cne 2
    cne 3
)
